# Runtime: Supabase Transaction Pooler (port 6543), with a conservative Prisma pool.
DATABASE_URL="postgresql://user:password@transaction-pooler-host:6543/database?schema=public&pgbouncer=true&connection_limit=5&pool_timeout=10"
# Prisma CLI/migrations: direct PostgreSQL or Supabase Session Pooler (port 5432).
DIRECT_URL="postgresql://user:password@direct-or-session-host:5432/database?schema=public"
PORT=3001
FRONTEND_URL="http://localhost:3000"
CRM_TEST_EMAIL=
CRM_TEST_PASSWORD=
